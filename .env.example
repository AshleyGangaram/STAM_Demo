# Copy this file to .env and fill in your values

# ── Claude AI (narratives, analysis reports) ──────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Location Capture ──────────────────────────────────────────────────────────
# Google Places API (New) key — enables address/landmark search.
# Requires a Google Cloud project with billing and the Places API (New) enabled.
# Leave blank to fall back to free OpenStreetMap/Nominatim search.
GOOGLE_MAPS_API_KEY=

# Geocoder provider: "google" (default) or "nominatim"
CAPTURE_GEOCODER=google

# ── Authentication ────────────────────────────────────────────────────────────
# Password for the bootstrap "admin" account, created on first startup.
# Leave blank to use the documented demo default (ChangeMe!2026) — the app will
# keep warning until this is set or the password is changed in User Admin.
STAM_ADMIN_PASSWORD=

# Optional passwords for the seeded demo accounts
STAM_CAPTURER_PASSWORD=
STAM_ANALYST_PASSWORD=
